{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Fumen",
  "version": "0.5.3",
  "identifier": "dev.fumen.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1430",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Fumen",
        "width": 1440,
        "height": 900,
        "minWidth": 1000,
        "minHeight": 640,
        "center": true,
        "resizable": true,
        "decorations": false,
        "backgroundColor": "#0d0d0d",
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self' ipc: http://ipc.localhost",
        "img-src": "'self' data: blob: fumen: http://fumen.localhost https://assets.ppy.sh https://a.ppy.sh",
        "media-src": "'self' blob: fumen: http://fumen.localhost https://catboy.best https://osu.direct",
        "style-src": "'self' 'unsafe-inline'",
        "font-src": "'self' data:",
        "connect-src": "'self' ipc: http://ipc.localhost fumen: http://fumen.localhost"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "externalBin": ["binaries/fumen-realm"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDcxMkM1QTVBMUQyQTcwODUKUldTRmNDb2RXbG9zY1pTUkVOR2QxbUlBSGJtSCtncSt3SmEya1FUR0lJVVVDQjBJbGgvc0JBWG8K",
      "endpoints": ["https://fumen.dertesti.dev/updates/latest.json"],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
