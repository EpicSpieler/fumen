<Project Sdk="Microsoft.NET.Sdk">

  <!--
    fumen-import: imports beatmap archives into osu!lazer with lazer's own code (its
    BeatmapImporter on its client.realm). It runs on the installed lazer's own .NET runtime:
    Fumen hard-links lazer's install folder into its cache and starts this program from there
    (see src-tauri/src/lazer_import.rs). lazer's assemblies are reached by reflection only, so
    nothing of lazer is referenced or shipped here; the runtimeconfig is lazer's own.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <UseAppHost>true</UseAppHost>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>fumen-import</AssemblyName>
    <RootNamespace>FumenImport</RootNamespace>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <DebugType>none</DebugType>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

</Project>
